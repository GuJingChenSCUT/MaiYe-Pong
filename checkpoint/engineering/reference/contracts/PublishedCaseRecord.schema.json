{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hacku:contract:PublishedCaseRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source_group_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
    },
    "published_precision": {
      "enum": [
        "day",
        "month",
        "unknown"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "checked_on": {
      "type": "string",
      "format": "date"
    },
    "record_kind": {
      "enum": [
        "reported_complaint",
        "reported_complaint_summary",
        "reported_enforcement_case"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "platform_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "named",
            "anonymous",
            "unknown"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "name"
      ]
    },
    "buyer_claim": {
      "type": "string",
      "minLength": 1
    },
    "seller_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "reported_outcome": {
      "type": "string",
      "minLength": 1
    },
    "outcome_authority": {
      "enum": [
        "court",
        "regulator",
        "mediator_report",
        "platform_record",
        "party_claim",
        "unknown"
      ]
    },
    "root_cause_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "evidence_limitations": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "raw_redistribution": {
          "type": "boolean"
        },
        "external_model_use": {
          "enum": [
            "allowed",
            "denied",
            "review_required"
          ]
        }
      },
      "required": [
        "basis",
        "raw_redistribution",
        "external_model_use"
      ]
    },
    "review_status": {
      "enum": [
        "quarantined",
        "draft",
        "reviewed",
        "published",
        "withdrawn"
      ]
    },
    "dataset_split": {
      "enum": [
        "unassigned",
        "development",
        "validation",
        "holdout"
      ]
    }
  },
  "required": [
    "case_id",
    "source_group_id",
    "canonical_url",
    "published_at",
    "published_precision",
    "retrieved_at",
    "checked_on",
    "record_kind",
    "jurisdiction",
    "platform_identity",
    "buyer_claim",
    "seller_response",
    "reported_outcome",
    "outcome_authority",
    "root_cause_hypothesis",
    "evidence_limitations",
    "tags",
    "rights",
    "review_status",
    "dataset_split"
  ]
}

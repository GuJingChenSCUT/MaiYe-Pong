{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hacku:contract:SellerOrderView",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "quote_id": {
      "type": "string",
      "minLength": 1
    },
    "order_state": {
      "type": "string",
      "minLength": 1
    },
    "payment_state": {
      "type": "string",
      "minLength": 1
    },
    "cash_payable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "currency",
        "amount_minor"
      ]
    },
    "fulfilment_state": {
      "type": "string",
      "minLength": 1
    },
    "case_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "stream_cursor": {
      "type": "string",
      "minLength": 1
    },
    "projection": {
      "const": "seller"
    },
    "merchant_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "order_id",
    "version",
    "quote_id",
    "order_state",
    "payment_state",
    "cash_payable",
    "fulfilment_state",
    "case_state",
    "stream_cursor",
    "projection",
    "merchant_id"
  ]
}

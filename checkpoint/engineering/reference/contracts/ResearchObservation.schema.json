{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hacku:contract:ResearchObservation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source_group_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
    },
    "published_precision": {
      "enum": [
        "day",
        "month",
        "unknown"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "checked_on": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "evidence_limitations": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "raw_redistribution": {
          "type": "boolean"
        },
        "external_model_use": {
          "enum": [
            "allowed",
            "denied",
            "review_required"
          ]
        }
      },
      "required": [
        "basis",
        "raw_redistribution",
        "external_model_use"
      ]
    },
    "review_status": {
      "enum": [
        "quarantined",
        "draft",
        "reviewed",
        "published",
        "withdrawn"
      ]
    },
    "dataset_split": {
      "enum": [
        "unassigned",
        "development",
        "validation",
        "holdout"
      ]
    },
    "record_kind": {
      "const": "research_observation"
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "study_method": {
      "type": "string",
      "minLength": 1
    },
    "sample_description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "case_id",
    "source_group_id",
    "canonical_url",
    "published_at",
    "published_precision",
    "retrieved_at",
    "checked_on",
    "jurisdiction",
    "evidence_limitations",
    "tags",
    "rights",
    "review_status",
    "dataset_split",
    "record_kind",
    "finding",
    "study_method",
    "sample_description"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hacku:contract:EvidenceRef",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "verified",
        "reported",
        "unverified",
        "superseded"
      ]
    }
  },
  "required": [
    "source_id",
    "locator",
    "checked_at",
    "status"
  ]
}
